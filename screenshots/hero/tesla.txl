[basestyles]
"normal" = {font_family="Noto Serif", font_size=10.5, line_spacing=1.2, name="Normal", role="normal", space_after=6}
"body" = {alignment="justify", font_family="Noto Serif", font_size=10.5, line_spacing=1.2, name="Body", space_after=6}
"h1" = {bold, font_family="Arial", font_size=22, name="Heading 1", role="h1", space_after=10}
"h2" = {bold, font_family="Arial", font_size=14, keep_with_next, name="Heading 2", role="h2", space_after=6, space_before=16}
"list_p" = {font_family="Noto Serif", font_size=10.5, line_spacing=1.2, name="List", paragraph_type="list", role="bullet", space_after=2}
"quote" = {alignment="left", font_family="Noto Serif", font_size=11.5, italic, line_spacing=1.2, hyphenate=False, name="Quote", right_indent=28.35, space_after=2, space_before=10}
"source" = {alignment="right", font_family="Noto Serif", font_size=10, color="#555555", name="Quote source", right_indent=28.35, space_after=6}
"cell" = {font_family="Arial", font_size=10, name="Table", space_after=0}

[document]
PROPS({author="MiniWord", footer_center=('page', ''), header_right=('title', ''), hyphenation, language="en-US", title="Nikola Tesla"})
T('Nikola Tesla: The Wizard of Electricity')
NL({base="h1", space_before=0})
IMG('375a764dc5fb2566.jpg', {alt="Nikola Tesla, around 1890", scale_x=0.23, scale_y=0.23})
NL({alignment="center", space_after=4})
T('Nikola Tesla', {bold, color="#8b2500", font_family="Arial", font_size=11})
T(' (1856–1943) was a Serbian-American inventor and electrical engineer. His alternating current system still carries the power that lights our homes, and his name lives on as the unit of magnetic flux density.')
NL({base="body", space_after=10})
T('Alternating current')
NL({base="h2"})
T('Tesla came to New York in 1884 and briefly worked for Thomas Edison,')
FN(
  T('Thomas Alva Edison (1847–1931), American inventor and businessman.')
  ENDMARK
)
T(' who favoured direct current. Tesla was convinced that ')
T('alternating current', {italic})
T(' could carry energy much farther. His most important ideas were:')
NL({base="body"})
T('the induction motor and the polyphase AC system and')
NL({base="list_p"})
T('the Tesla coil for very high voltages at high frequency.')
NL({base="list_p", space_after=6})
T('The progressive development of man is vitally dependent on invention.')
NL({base="quote", indent=1})
T('Nikola Tesla, ')
T('My Inventions', {italic})
T(', 1919')
NL({base="source"})
T('Inventions at a glance')
NL({base="h2"})
C("table",
  {col_widths=(50, 140, None), ncols=3, nheader=1},
  [T('Year', {bold, color="white"}), {base="cell", border_left="none", border_right="none", border_top="thick", border_bottom="thick", cell_bgcolor="#1f3a5f", valign="middle", alignment="center"}],
  [T('Invention', {bold, color="white"}), {base="cell", border_left="none", border_right="none", border_top="thick", border_bottom="thick", cell_bgcolor="#1f3a5f", valign="middle"}],
  [T('Significance', {bold, color="white"}), {base="cell", border_left="none", border_right="none", border_top="thick", border_bottom="thick", cell_bgcolor="#1f3a5f", valign="middle"}],
  [T('1888'), {base="cell", border_left="none", border_right="none", border_top="thick", border_bottom="thin", alignment="center"}],
  [T('Induction motor'), {base="cell", border_left="none", border_right="none", border_top="thick", border_bottom="thin"}],
  [T('Motors without brushes'), {base="cell", border_left="none", border_right="none", border_top="thick", border_bottom="thin"}],
  [T('1891'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thin", cell_bgcolor="#eef2f6", alignment="center"}],
  [T('Tesla coil'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thin", cell_bgcolor="#eef2f6"}],
  [T('Extremely high voltages'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thin", cell_bgcolor="#eef2f6"}],
  [T('1895'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thin", alignment="center"}],
  [T('Niagara Falls plant'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thin"}],
  [T('Power for a whole city'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thin"}],
  [T('1898'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thick", cell_bgcolor="#eef2f6", alignment="center"}],
  [T('Remote-control boat'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thick", cell_bgcolor="#eef2f6"}],
  [T('Steered by radio waves'), {base="cell", border_left="none", border_right="none", border_top="thin", border_bottom="thick", cell_bgcolor="#eef2f6"}]
)
NL({base="body"})
ENDMARK

[blobs]
"375a764dc5fb2566.jpg" = ""
